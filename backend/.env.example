# Paisa Remit Backend Environment Configuration
APP_NAME="Paisa Remit API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.paisaremit.com

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paisa_remit_db
DB_USERNAME=paisa_user
DB_PASSWORD="YourStrongPassword2026!"

# JWT & Encryption
JWT_SECRET="generate_a_random_64_character_secret_key_here"
API_RATE_LIMIT_PER_MINUTE=60

# SMS Gateway Configuration (Twilio / Onnorokom SMS / Infobip)
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=""
SMS_SENDER_ID="PAISAREMIT"

# Admin Master Credentials
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS="Admin@Paisa2026!"
